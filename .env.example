# Valores compatibles con docker-compose.yml para desarrollo local.
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=restaurante
DB_PASSWORD=restaurante
DB_DATABASE=restaurante

# Genera un secreto aleatorio de al menos 32 caracteres.
JWT_SECRET=ReemplazarPorUnSecretoAleatorioDe32Caracteres

# Frontend que recibe el enlace de verificación.
APP_URL=http://localhost:4200

# Para envíos reales con Resend, configura ambos valores.
# RESEND_API_KEY=re_tu_clave
# MAIL_FROM=Restaurante <cuentas@tudominio.com>
RESEND_API_KEY=tu_clave
MAIL_FROM=Restaurante <cuentas@tudominio.com>

# Inicio de sesión con Google (opcional): configura ambos valores en el servidor.
FRONTEND_CALLBACK_URL=http://localhost:4200/auth/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:3000/api/v1/auth/oidc/google/callback


# Orígenes adicionales del frontend, separados por comas.
CORS_ORIGINS=http://localhost:4200
